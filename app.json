{
  "expo": {
    "locales": {
      "en": "./locales/en.json",
      "ko": "./locales/ko.json",
      "ja": "./locales/ja.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json",
      "vi": "./locales/vi.json",
      "id": "./locales/id.json",
      "th": "./locales/th.json",
      "ru": "./locales/ru.json",
      "es": "./locales/es.json"
    },
    "name": "K-Bap",
    "slug": "kbap",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kbap",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rocher.kbap",
      "appleTeamId": "GBF7H2D9C5",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram-stories"
        ]
      }
    },
    "android": {
      "package": "com.rocher.kbap",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ko",
              "zh-Hans",
              "zh-Hant",
              "ja",
              "vi",
              "id",
              "th",
              "ru",
              "es"
            ],
            "android": [
              "en",
              "ko",
              "zh-Hans",
              "zh-Hant",
              "ja",
              "vi",
              "id",
              "th",
              "ru",
              "es"
            ]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "K-Bap uses the camera to scan menus, take photos for your reviews, and set your profile picture.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "K-Bap accesses your photos so you can scan a saved menu, add photos to reviews and posts, set a profile picture, or attach them to an inquiry."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "K-Bap uses your location to find nearby restaurants, so you can tag a place in a review and record where you ate.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "K-Bap uses motion to notice when your phone is turned sideways while you scan a menu."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#E2580C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-mark-ios.png",
          "imageWidth": 95,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/splash-mark-android.png",
            "imageWidth": 131
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "K-Bap uses motion to notice when your phone is turned sideways while you scan a menu."
        }
      ],
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.44799256321-nnhh4i2smd3n7ddejlmhdr1598ckmdj2"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "skyjs",
          "project": "react-native"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Save your K-Bap story card to your photo library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "2530115400831168",
          "displayName": "K-Bap",
          "scheme": "fb2530115400831168",
          "clientToken": "871dfc2051ca5e11ebf616e5567208cc",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": true
        }
      ],
      [
        "react-native-share",
        {
          "android": [
            "com.instagram.android"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "249f1d0b-6a85-4aaf-ac33-973f558ce180"
      },
      "metaAppId": "2530115400831168"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/249f1d0b-6a85-4aaf-ac33-973f558ce180"
    }
  }
}
